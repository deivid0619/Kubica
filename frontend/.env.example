# URL del backend. En desarrollo, vite ya hace de proxy para /api, así que
# puedes dejar esto vacío. En producción (Vercel), apunta a tu API en Render.
VITE_API_URL=

# La marca (nombre, colores, logo e iconos). Vacio: la marca propia, Kubica.
# "pigmalion": los de Pigmalion. Ver src/core/marca.js y src/styles/marcas.css.
VITE_MARCA=

# SOLO LA DEMO PUBLICA (render-demo.yaml): la llave del enlace "solo ver" con
# que entra cualquiera (la misma que DEMO_VIEW_KEY del backend) y el WhatsApp
# de la barra "Pídela para tu bodega". Vacios en una instalacion de verdad.
VITE_DEMO_KEY=
VITE_DEMO_WHATSAPP=
